FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# The worker executes queued C, C++, Java, and Python jobs locally.  No Paiza
# or Piston service is contacted from this image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

CMD ["python", "-m", "services.execution.worker"]
